# Copie para .env e preencha. Nenhuma outra configuração exige mexer no código.

# --- LLM (obrigatórias) -------------------------------------------------------
# Qualquer modelo suportado pelo LiteLLM, no formato <provedor>/<modelo>.
# Exemplos: gemini/gemini-2.5-flash, anthropic/claude-sonnet-5-5, openai/gpt-4o
LLM_MODEL=
LLM_API_KEY=

# --- LLM (opcional) -----------------------------------------------------------
# Endereço de um provedor compatível ou proxy próprio (ex.: LiteLLM proxy, Ollama).
LLM_API_BASE=
